# Copy to .env for local development. On Render set these under Environment.
#
# Every key here is optional. With none of them the app still boots and serves
# hybrid retrieval, because embeddings run locally on CPU. Add any one key to
# turn on written answers.

# ---- Providers. Any single one is enough. -----------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=

# Which provider to try first when several are configured.
PROVIDER_PRIORITY=groq,gemini,openai,huggingface

# ---- Model names. Override when a provider renames or retires a model. ------
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_DEEP_MODEL=openai/gpt-oss-120b
# GEMINI_FAST_MODEL=gemini-2.5-flash
# GEMINI_DEEP_MODEL=gemini-2.5-pro
# OPENAI_FAST_MODEL=gpt-4o-mini
# OPENAI_DEEP_MODEL=gpt-4o
# HF_FAST_MODEL=meta-llama/Llama-3.3-70B-Instruct
# HF_DEEP_MODEL=Qwen/Qwen2.5-72B-Instruct

# Point the openai provider at any OpenAI compatible gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---- Behaviour --------------------------------------------------------------
# Let visitors paste their own key in the settings panel.
ALLOW_BYO_KEY=true

# Requests per minute per client address. Set to 0 to disable.
RATE_LIMIT_PER_MINUTE=20

# Passages retrieved per question.
RETRIEVAL_TOP_K=8

# Upload ceiling in bytes.
MAX_UPLOAD_BYTES=8388608

LOG_LEVEL=INFO

# --- Cloudflare Workers AI ---------------------------------------------------
# BOTH are needed. The account id forms part of the request URL, so a token on
# its own cannot address anything. The token needs the Workers AI permission.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_FAST_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# CLOUDFLARE_DEEP_MODEL=@cf/openai/gpt-oss-120b
